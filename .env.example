# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# JWT Secret Key for session management (Rubric: Authentication & Session Management)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-32-bytes-minimum

# AES-256 Encryption Key for sensitive data (Rubric: Data Encryption At Rest)
# Generate with: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Database Configuration (Rubric: Database Security)
DATABASE_URL=sqlite:///secure_app.db

# Application Settings (Rubric: Security Configuration)
DEBUG=False
HOST=127.0.0.1
PORT=8000

# Security Settings (Rubric: Security Headers & Protection)
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
SESSION_DURATION_HOURS=2
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Production Settings (Rubric: Production Security)
HTTPS_ONLY=True
SECURE_COOKIES=True
