# Environment Configuration - Production Values
# Secure Web Application - Real Configuration

# JWT Secret Key for session management (Rubric: Authentication & Session Management)
SECRET_KEY=super-secret-key-for-jwt-tokens-32-bytes-minimum-length

# AES-256 Encryption Key for sensitive data (Rubric: Data Encryption At Rest)
ENCRYPTION_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Database Configuration (Rubric: Database Security)
DATABASE_URL=sqlite:///secure_app.db

# Application Settings (Rubric: Security Configuration)
DEBUG=False
HOST=127.0.0.1
PORT=8000

# Security Settings (Rubric: Security Headers & Protection)
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
SESSION_DURATION_HOURS=2
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Production Settings (Rubric: Production Security)
HTTPS_ONLY=False
SECURE_COOKIES=True
